<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lux.App.ViewModels"
             xmlns:c="using:Lux.App.Controls"
             x:Class="Lux.App.Views.QueueView"
             x:DataType="vm:QueueViewModel">
  <!-- Every background job (S-Export, right half), grouped running / waiting / failed / finished. -->
  <DockPanel Margin="16,16,16,0" MaxWidth="1100" HorizontalAlignment="Stretch">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="0,0,0,12">
      <TextBlock Classes="heading" Text="Queue" VerticalAlignment="Center" />
      <TextBlock Grid.Column="1" Classes="secondary" Text="{Binding Summary}" VerticalAlignment="Center" Margin="12,0,0,0" />
      <Button Grid.Column="3" Content="{Binding PauseLabel}" Command="{Binding TogglePauseCommand}" Margin="0,0,8,0"
              ToolTip.Tip="Start no new job until resumed; running jobs finish" />
      <Button Grid.Column="4" Content="Clear finished" Command="{Binding ClearFinishedCommand}" IsEnabled="{Binding HasFinished}" />
    </Grid>
    <Panel>
      <StackPanel IsVisible="{Binding IsEmpty}" Spacing="6" Margin="0,40" HorizontalAlignment="Center">
        <TextBlock Classes="heading" Text="Nothing in the queue" HorizontalAlignment="Center" />
        <TextBlock Classes="secondary" Text="Analysis, working copies, thumbnails, exports, animations, imports and other work on your photos appear here while they run." HorizontalAlignment="Center" />
      </StackPanel>
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="Rows" ItemsSource="{Binding Rows}" Margin="0,0,0,16" AutomationProperties.Name="Jobs">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.DataTemplates>
            <DataTemplate DataType="vm:QueueGroupViewModel">
              <TextBlock Classes="strong secondary" Text="{Binding Label}" Margin="0,10,0,8" />
            </DataTemplate>
            <DataTemplate DataType="vm:QueueBatchViewModel">
              <Border Classes="job" Classes.running="{Binding IsRunning}" Classes.failed="{Binding HasFailed}" Margin="0,0,0,6" AutomationProperties.Name="{Binding Title}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel Spacing="4" VerticalAlignment="Center">
                    <TextBlock Classes="strong" Text="{Binding Title}" />
                    <ProgressBar Value="{Binding Progress}" Classes.done="{Binding IsAllDone}" Classes.failed="{Binding HasFailed}" />
                    <TextBlock Classes="secondary small" Text="{Binding Summary}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="Remove all" Command="{Binding SecondaryCommand}" IsVisible="{Binding HasSecondaryAction}" />
                    <Button Content="{Binding PrimaryAction}" Command="{Binding PrimaryCommand}" MinWidth="104" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
            <DataTemplate DataType="vm:ActivityRowViewModel">
              <Border Classes="job running" AutomationProperties.Name="{Binding Title}">
                <Grid ColumnDefinitions="64,*,Auto" ColumnSpacing="12">
                  <Panel Width="64" Height="48" VerticalAlignment="Center">
                    <c:ThumbnailView Width="64" Height="48" CaptureId="{Binding CaptureId}" Orientation="{Binding Orientation}" IsVisible="{Binding HasCapture}" Placeholder="{DynamicResource LuxPlaceholder}" />
                    <Border Background="{DynamicResource LuxLineMid}" IsVisible="{Binding !HasCapture}" />
                  </Panel>
                  <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    <ProgressBar Value="{Binding Progress}" IsIndeterminate="{Binding IsIndeterminate}" Minimum="0" Maximum="1" />
                    <TextBlock Classes="secondary small" Text="{Binding StatusText}" />
                  </StackPanel>
                  <Button Grid.Column="2" Content="Stop" Command="{Binding StopCommand}" IsVisible="{Binding CanCancel}" MinWidth="88" VerticalAlignment="Center"
                          ToolTip.Tip="Stop this work now (nothing it half-made is kept)" />
                </Grid>
              </Border>
            </DataTemplate>
            <DataTemplate DataType="vm:JobViewModel">
              <Border Classes="job" Classes.running="{Binding IsRunning}" Classes.failed="{Binding IsFailed}" Classes.inbatch="{Binding InBatch}">
                <Grid ColumnDefinitions="64,*,Auto" ColumnSpacing="12">
                  <Panel Width="64" Height="48" VerticalAlignment="Center">
                    <c:ThumbnailView Width="64" Height="48" CaptureId="{Binding CaptureId}" Orientation="{Binding Orientation}" IsVisible="{Binding HasCapture}" Placeholder="{DynamicResource LuxPlaceholder}" />
                    <Border Background="{DynamicResource LuxLineMid}" IsVisible="{Binding !HasCapture}">
                      <TextBlock Classes="mono" Text="{Binding KindInitial}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                  </Panel>
                  <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <WrapPanel>
                      <TextBlock Classes="mono" Text="{Binding Name}" Margin="0,0,10,0" IsVisible="{Binding Name, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                      <TextBlock Classes="secondary" Text="{Binding What}" />
                    </WrapPanel>
                    <TextBlock Classes="mono small secondary trim" Text="{Binding FileLine}" IsVisible="{Binding HasFileLine}" />
                    <ProgressBar Value="{Binding Progress}" Classes.done="{Binding IsDone}" Classes.failed="{Binding IsFailed}" />
                    <!-- the reason of a failed job wraps, so that it shows in full -->
                    <TextBlock Classes="secondary small" Text="{Binding StatusText}" TextWrapping="{Binding StatusWrapping}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="Remove" Command="{Binding SecondaryCommand}" IsVisible="{Binding HasSecondaryAction}" />
                    <Button Content="{Binding PrimaryAction}" Command="{Binding PrimaryCommand}" MinWidth="88" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.DataTemplates>
        </ItemsControl>
      </ScrollViewer>
    </Panel>
  </DockPanel>
</UserControl>
