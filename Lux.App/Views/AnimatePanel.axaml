<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Lux.App.ViewModels"
             x:Class="Lux.App.Views.AnimatePanel"
             x:DataType="vm:AnimatePanelViewModel">
  <!-- "Animate…" as a side panel on the page it starts from: effect, its settings, size and file type, the expected size and time. The
       preview plays on the page's picture area (AnimationPlayer). -->
  <Border Classes="sidepanel" Width="{DynamicResource LuxSidePanelWidth}">
    <DockPanel>
      <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource LuxLineDark}" BorderThickness="0,1,0,0" Padding="16,12">
        <Grid ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto">
          <TextBlock Grid.ColumnSpan="3" Classes="secondary wrap" Text="{Binding Estimate}" Margin="0,0,0,10" AutomationProperties.Name="Estimate" />
          <TextBlock Grid.Row="1" Classes="warning wrap" Text="{Binding Error}" VerticalAlignment="Center"
                     IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <Button Grid.Row="1" Grid.Column="1" Content="Cancel" Command="{Binding CancelCommand}" Margin="8,0,8,0" />
          <Button Grid.Row="1" Grid.Column="2" Classes="primary" Content="Add to queue" Command="{Binding AddToQueueCommand}" IsEnabled="{Binding CanAdd}" />
        </Grid>
      </Border>
      <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" Margin="16">
          <StackPanel Spacing="4">
            <TextBlock Classes="heading" Text="{Binding Title}" />
            <TextBlock Classes="secondary" Text="{Binding NamesLine}" />
          </StackPanel>

          <!-- the effects -->
          <StackPanel Spacing="6">
            <TextBlock Classes="strong" Text="Effect" />
            <ItemsControl ItemsSource="{Binding Effects}" AutomationProperties.Name="Effects">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:EffectChoiceViewModel">
                  <Button Classes="row effect" Classes.selected="{Binding IsSelected}" Command="{Binding SelectCommand}" IsEnabled="{Binding IsAvailable}"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,8" AutomationProperties.Name="{Binding Name}"
                          ToolTip.Tip="{Binding Reason}" ToolTip.ShowOnDisabled="True">
                    <StackPanel Spacing="2">
                      <TextBlock Classes="medium" Text="{Binding Name}" />
                      <TextBlock Classes="small secondary wrap" Text="{Binding SubText}" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border Classes="note" IsVisible="{Binding EffectNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock Classes="wrap small" Text="{Binding EffectNote}" />
            </Border>
            <!-- what the preview's frames show: why nothing (or little) changes on this photo with these settings -->
            <Border Classes="warningbox" IsVisible="{Binding PreviewNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" AutomationProperties.Name="About this preview">
              <TextBlock x:Name="PreviewNoteText" Classes="wrap small" Text="{Binding PreviewNote}" />
            </Border>
            <!-- the preview's detail next to the file's: said when the frames that play are smaller than the file's -->
            <Border Classes="note" IsVisible="{Binding PreviewDetailNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" AutomationProperties.Name="Preview detail">
              <TextBlock x:Name="PreviewDetailText" Classes="wrap small" Text="{Binding PreviewDetailNote}" />
            </Border>
            <!-- always shown: the preview is not the file. The player plays only when every frame is ready at preview quality. -->
            <TextBlock x:Name="PreviewQualityText" Classes="secondary small wrap"
                       Text="The preview is made at preview quality. The exported file can show more detail." />
          </StackPanel>

          <!-- the effect's settings: one row each, shown for the effects that use it -->
          <StackPanel Spacing="10">
            <Grid ColumnDefinitions="110,*" ColumnSpacing="12" IsVisible="{Binding IsDepthEffect}">
              <TextBlock Text="{Binding ApertureLabel}" VerticalAlignment="Center" />
              <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                <Slider Minimum="2" Maximum="16" SmallChange="0.1" LargeChange="1" Value="{Binding FNumber}" AutomationProperties.Name="Aperture" />
                <TextBlock Grid.Column="1" Classes="mono" Text="{Binding FNumberText}" VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="44" />
              </Grid>
            </Grid>
            <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="12" IsVisible="{Binding IsRack}">
              <TextBlock Text="Focus from" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" Classes="mono" Text="{Binding FocusFromText}" Watermark="near · meters" AutomationProperties.Name="Focus from, meters" />
              <Button Grid.Column="2" Content="Pick" Classes.primary="{Binding IsPickingFrom}" Command="{Binding PickFromCommand}" Padding="14,0"
                      ToolTip.Tip="Click the photo where the focus starts" AutomationProperties.Name="Pick the start on the photo" />
            </Grid>
            <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="12" IsVisible="{Binding IsRack}">
              <TextBlock Text="Focus to" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" Classes="mono" Text="{Binding FocusToText}" Watermark="far · meters" AutomationProperties.Name="Focus to, meters" />
              <Button Grid.Column="2" Content="Pick" Classes.primary="{Binding IsPickingTo}" Command="{Binding PickToCommand}" Padding="14,0"
                      ToolTip.Tip="Click the photo where the focus ends" AutomationProperties.Name="Pick the end on the photo" />
            </Grid>
            <Grid ColumnDefinitions="110,*,Auto" ColumnSpacing="12" IsVisible="{Binding IsAperture}">
              <TextBlock Text="Focus" VerticalAlignment="Center" />
              <TextBox Grid.Column="1" Classes="mono" Text="{Binding FocusText}" Watermark="as the camera focused" AutomationProperties.Name="Focus, meters" />
              <Button Grid.Column="2" Content="Pick" Classes.primary="{Binding IsPickingFocus}" Command="{Binding PickFocusCommand}" Padding="14,0"
                      ToolTip.Tip="Click the photo where it stays sharp" AutomationProperties.Name="Pick the focus on the photo" />
            </Grid>
            <Grid ColumnDefinitions="110,*" ColumnSpacing="12" IsVisible="{Binding IsParallax}">
              <TextBlock Text="Path" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding Paths}" SelectedItem="{Binding Path}" AutomationProperties.Name="Path" />
            </Grid>
            <Grid ColumnDefinitions="110,*" ColumnSpacing="12" IsVisible="{Binding IsParallax}">
              <TextBlock Text="Movement" VerticalAlignment="Center" />
              <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                <Slider Minimum="20" Maximum="150" SmallChange="1" LargeChange="10" Value="{Binding Amplitude}" AutomationProperties.Name="Movement, millimeters" />
                <TextBlock Grid.Column="1" Classes="mono" Text="{Binding AmplitudeText}" VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="56" />
              </Grid>
            </Grid>
            <!-- the zoom-through and the pan-and-zoom: the target, picked on the first frame of the preview -->
            <Grid ColumnDefinitions="110,*,Auto,Auto" ColumnSpacing="12" IsVisible="{Binding HasTargetPick}">
              <TextBlock Text="{Binding TargetLabel}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="1" Classes="small wrap" Text="{Binding TargetText}" VerticalAlignment="Center" AutomationProperties.Name="Target" />
              <Button Grid.Column="2" Content="Pick" Classes.primary="{Binding IsPickingTarget}" Command="{Binding PickTargetPointCommand}" Padding="14,0"
                      ToolTip.Tip="Click the photo in the preview" AutomationProperties.Name="Pick the target on the photo" />
              <Button Grid.Column="3" Content="Auto" Command="{Binding ClearTargetCommand}" IsVisible="{Binding HasTarget}" Padding="10,0"
                      ToolTip.Tip="Let Lux choose the target" AutomationProperties.Name="Choose the target automatically" />
            </Grid>
            <Grid ColumnDefinitions="110,*" ColumnSpacing="12" IsVisible="{Binding IsPan}">
              <TextBlock Text="Camera travel" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding Travels}" SelectedItem="{Binding Travel}" HorizontalAlignment="Stretch" AutomationProperties.Name="Camera travel" />
            </Grid>
            <Grid ColumnDefinitions="110,*" ColumnSpacing="12" IsVisible="{Binding IsFog}">
              <TextBlock Text="Movement" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding FogModes}" SelectedItem="{Binding FogMode}" HorizontalAlignment="Stretch" AutomationProperties.Name="Fog movement" />
            </Grid>
            <Grid ColumnDefinitions="110,*" ColumnSpacing="12" IsVisible="{Binding IsFog}">
              <TextBlock Text="Density" VerticalAlignment="Center" />
              <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                <Slider Minimum="0.25" Maximum="3" SmallChange="0.05" LargeChange="0.25" Value="{Binding FogDensity}" AutomationProperties.Name="Fog density" />
                <TextBlock Grid.Column="1" Classes="mono" Text="{Binding FogDensityText}" VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="56" />
              </Grid>
            </Grid>
            <Grid ColumnDefinitions="110,*" ColumnSpacing="12" IsVisible="{Binding IsSlice}">
              <TextBlock Text="Order" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding SliceOrders}" SelectedItem="{Binding SliceOrder}" HorizontalAlignment="Stretch" AutomationProperties.Name="Slice order" />
            </Grid>
            <Grid ColumnDefinitions="110,*" ColumnSpacing="12" IsVisible="{Binding IsSlice}">
              <TextBlock Text="Soft edge" VerticalAlignment="Center" />
              <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                <Slider Minimum="0" Maximum="0.25" SmallChange="0.01" LargeChange="0.05" Value="{Binding Softness}" AutomationProperties.Name="Soft edge" />
                <TextBlock Grid.Column="1" Classes="mono" Text="{Binding SoftnessText}" VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="56" />
              </Grid>
            </Grid>
            <Grid ColumnDefinitions="110,*" ColumnSpacing="12" IsVisible="{Binding IsTilt}">
              <TextBlock Text="Aperture" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding Miniatures}" SelectedItem="{Binding Miniature}" HorizontalAlignment="Stretch" AutomationProperties.Name="Miniature aperture" />
            </Grid>
            <Grid ColumnDefinitions="110,*" ColumnSpacing="12" IsVisible="{Binding IsTilt}">
              <TextBlock Text="Tilt" VerticalAlignment="Center" />
              <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                <Slider Minimum="0" Maximum="1.5" SmallChange="0.1" LargeChange="0.3" Value="{Binding Tilt}" AutomationProperties.Name="Tilt" />
                <TextBlock Grid.Column="1" Classes="mono" Text="{Binding TiltText}" VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="56" />
              </Grid>
            </Grid>
            <Grid ColumnDefinitions="110,*" ColumnSpacing="12" IsVisible="{Binding HasFrameCount}">
              <TextBlock Text="Frames" VerticalAlignment="Center" />
              <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
                <Slider Minimum="{Binding FramesMin}" Maximum="{Binding FramesMax}" SmallChange="1" LargeChange="6" Value="{Binding Frames}" IsSnapToTickEnabled="True" TickFrequency="1" AutomationProperties.Name="Frames" />
                <TextBlock Grid.Column="1" Classes="mono" Text="{Binding FramesText}" VerticalAlignment="Center" Margin="12,0,0,0" MinWidth="76" />
              </Grid>
            </Grid>
            <CheckBox Classes="optionrow" IsChecked="{Binding SingleView}" IsVisible="{Binding IsParallax}"
                      Content="From the main view only (gaps painted in)" AutomationProperties.Name="From the main view only" />
          </StackPanel>
          <TextBlock Classes="small secondary wrap" IsVisible="{Binding IsRack}"
                     Text="Empty: the nearer or farther parts of the scene. Pick: click the photo in the preview." />

          <!-- play and output -->
          <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="12">
            <TextBlock Text="Play" VerticalAlignment="Center" />
            <Grid Grid.Column="1" ColumnDefinitions="*,Auto">
              <CheckBox IsChecked="{Binding PingPong}" Content="Forward and back" AutomationProperties.Name="Forward and back" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding Repeats}" SelectedItem="{Binding Repeat}" MinWidth="120" AutomationProperties.Name="Repeat" />
            </Grid>
            <TextBlock Grid.Row="1" Text="Size" VerticalAlignment="Center" />
            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Sizes}" SelectedItem="{Binding Size}" AutomationProperties.Name="Size" />
            <TextBlock Grid.Row="2" Text="File type" VerticalAlignment="Center" />
            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Formats}" SelectedItem="{Binding Format}" AutomationProperties.Name="File type" />
            <TextBlock Grid.Row="3" Text="GIF colors" VerticalAlignment="Center" IsVisible="{Binding IsGif}" />
            <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding Dithers}" SelectedItem="{Binding Dither}" IsVisible="{Binding IsGif}" AutomationProperties.Name="GIF colors" />
            <TextBlock Grid.Row="4" Text="Folder" VerticalAlignment="Center" />
            <Grid Grid.Row="4" Grid.Column="1" ColumnDefinitions="*,Auto">
              <TextBox Classes="tall mono" Text="{Binding Folder}" AutomationProperties.Name="Animation folder" />
              <Button Grid.Column="1" Content="Choose…" Command="{Binding ChooseFolderCommand}" Margin="6,0,0,0" />
            </Grid>
            <TextBlock Grid.Row="5" Text="Orientation" VerticalAlignment="Center" IsVisible="{Binding HasTurnedPhotos}" />
            <ComboBox Grid.Row="5" Grid.Column="1" ItemsSource="{Binding OrientationChoices}" SelectedItem="{Binding Orientation}" IsVisible="{Binding HasTurnedPhotos}"
                      AutomationProperties.Name="Orientation" ToolTip.Tip="This photo is shown the way the camera was held: animate it that way, or as the camera recorded it" />
          </Grid>
          <Border Classes="note" IsVisible="{Binding HasVideoNote}">
            <TextBlock Classes="wrap small" Text="{Binding VideoNote}" />
          </Border>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Border>
</UserControl>
