<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    Control themes Lux owns outright (buttons, toggles, check boxes, progress bars). Variants are classes:

    Button / ToggleButton
      (none)     outline #6a6a6a          .primary   accent fill, dark text      .accent   accent outline
      .link      accent text, no frame    .ghost     secondary text, no frame    .tab      header tab (.selected / :checked)
      .seg       segmented switch item    .chip      filter chip (:checked)      .tree     folder-tree row (.selected, .heading)
      .row       plain full-width row     .small     32 px high (dense places only)
    ProgressBar  .done (success)  .failed (warning)
  -->

  <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Style Selector="^:focus-visible /template/ Border#PART_Focus">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource LuxText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LuxLineLight}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource LuxRadius}" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="MinHeight" Value="{DynamicResource LuxControlHeight}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="{DynamicResource LuxFontSize}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Border"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <Panel>
            <Border Name="PART_State" Background="Transparent" IsHitTestVisible="False" />
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              Foreground="{TemplateBinding Foreground}"
                              RecognizesAccessKey="True"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            <Border Name="PART_Focus" BorderBrush="{DynamicResource LuxAccent}" BorderThickness="2" CornerRadius="{TemplateBinding CornerRadius}"
                    IsVisible="False" IsHitTestVisible="False" Margin="-1" />
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:pointerover /template/ Border#PART_State">
      <Setter Property="Background" Value="{DynamicResource LuxHover}" />
    </Style>
    <Style Selector="^:pressed /template/ Border#PART_State">
      <Setter Property="Background" Value="{DynamicResource LuxPressed}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource LuxTextDisabled}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LuxLineMid}" />
    </Style>

    <Style Selector="^.small">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="10,0" />
    </Style>
    <Style Selector="^.primary">
      <Setter Property="Background" Value="{DynamicResource LuxAccent}" />
      <Setter Property="Foreground" Value="{DynamicResource LuxOnAccent}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="18,0" />
    </Style>
    <Style Selector="^.primary:pointerover">
      <Setter Property="Background" Value="{DynamicResource LuxAccentHover}" />
    </Style>
    <Style Selector="^.primary:pointerover /template/ Border#PART_State">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="^.primary:pressed /template/ Border#PART_State">
      <Setter Property="Background" Value="#1A000000" />
    </Style>
    <Style Selector="^.primary:disabled">
      <Setter Property="Background" Value="{DynamicResource LuxLineMid}" />
      <Setter Property="Foreground" Value="{DynamicResource LuxTextDisabled}" />
    </Style>
    <Style Selector="^.accent">
      <Setter Property="BorderBrush" Value="{DynamicResource LuxAccent}" />
    </Style>
    <Style Selector="^.accent:disabled">
      <Setter Property="BorderBrush" Value="{DynamicResource LuxLineMid}" />
    </Style>
    <Style Selector="^.link">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource LuxAccent}" />
      <Setter Property="Padding" Value="8,0" />
    </Style>
    <Style Selector="^.link:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource LuxAccentHover}" />
    </Style>
    <Style Selector="^.link:disabled">
      <Setter Property="Foreground" Value="{DynamicResource LuxTextDisabled}" />
    </Style>
    <Style Selector="^.ghost">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource LuxTextSecondary}" />
      <Setter Property="Padding" Value="8,0" />
    </Style>
    <Style Selector="^.ghost:pointerover">
      <Setter Property="Foreground" Value="{DynamicResource LuxText}" />
    </Style>
    <Style Selector="^.tab">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="Foreground" Value="{DynamicResource LuxTextSecondary}" />
    </Style>
    <Style Selector="^.tab.selected">
      <Setter Property="Background" Value="{DynamicResource LuxGround}" />
      <Setter Property="Foreground" Value="{DynamicResource LuxText}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="^.tab:disabled">
      <Setter Property="Foreground" Value="{DynamicResource LuxTextDisabled}" />
    </Style>
    <Style Selector="^.seg">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="Foreground" Value="{DynamicResource LuxTextSecondary}" />
    </Style>
    <Style Selector="^.seg.selected">
      <Setter Property="Background" Value="{DynamicResource LuxLineDark}" />
      <Setter Property="Foreground" Value="{DynamicResource LuxText}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- a quality being made: accent text and an accent underline -->
    <Style Selector="^.seg.pending">
      <Setter Property="Foreground" Value="{DynamicResource LuxAccent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LuxAccent}" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="^.seg:disabled">
      <Setter Property="Foreground" Value="{DynamicResource LuxTextSecondary}" />
    </Style>
    <Style Selector="^.seg.selected:disabled">
      <Setter Property="Foreground" Value="{DynamicResource LuxText}" />
    </Style>
    <Style Selector="^.tree">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="12,0" />
    </Style>
    <Style Selector="^.tree.selected">
      <Setter Property="Background" Value="{DynamicResource LuxLineDark}" />
    </Style>
    <Style Selector="^.tree.droptarget">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource LuxAccent}" />
    </Style>
    <Style Selector="^.chip">
      <Setter Property="Padding" Value="12,0" />
    </Style>
    <Style Selector="^.chip.on">
      <Setter Property="Background" Value="{DynamicResource LuxLineDark}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LuxAccent}" />
    </Style>
    <Style Selector="^.row">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <!-- a selectable card of the Animate panel's effect list (.selected: accent edge, darker ground) -->
    <Style Selector="^.effect">
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource LuxLineMid}" />
      <Setter Property="CornerRadius" Value="{DynamicResource LuxRadius}" />
      <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>
    <Style Selector="^.effect.selected">
      <Setter Property="Background" Value="{DynamicResource LuxSelection}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LuxAccent}" />
    </Style>
    <Style Selector="^.effect:disabled">
      <Setter Property="Opacity" Value="0.7" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ToggleButton}" TargetType="ToggleButton">
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Style Selector="^:focus-visible /template/ Border#PART_Focus">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource LuxText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LuxLineLight}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource LuxRadius}" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="MinHeight" Value="{DynamicResource LuxControlHeight}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="{DynamicResource LuxFontSize}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Border"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <Panel>
            <Border Name="PART_State" Background="Transparent" IsHitTestVisible="False" />
            <ContentPresenter Name="PART_ContentPresenter"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              Foreground="{TemplateBinding Foreground}"
                              RecognizesAccessKey="True"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
            <Border Name="PART_Focus" BorderBrush="{DynamicResource LuxAccent}" BorderThickness="2" CornerRadius="{TemplateBinding CornerRadius}"
                    IsVisible="False" IsHitTestVisible="False" Margin="-1" />
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#PART_State">
      <Setter Property="Background" Value="{DynamicResource LuxHover}" />
    </Style>
    <Style Selector="^:pressed /template/ Border#PART_State">
      <Setter Property="Background" Value="{DynamicResource LuxPressed}" />
    </Style>
    <Style Selector="^:checked">
      <Setter Property="Background" Value="{DynamicResource LuxLineDark}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LuxAccent}" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource LuxTextDisabled}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LuxLineMid}" />
    </Style>
    <Style Selector="^.seg">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource LuxTextSecondary}" />
    </Style>
    <Style Selector="^.seg:checked">
      <Setter Property="Background" Value="{DynamicResource LuxLineDark}" />
      <Setter Property="Foreground" Value="{DynamicResource LuxText}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type CheckBox}" TargetType="CheckBox">
    <Setter Property="FocusAdorner" Value="{x:Null}" />
    <Style Selector="^:focus-visible /template/ Border#PART_Focus">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource LuxText}" />
    <Setter Property="BorderBrush" Value="{DynamicResource LuxTextSecondary}" />
    <Setter Property="MinHeight" Value="{DynamicResource LuxControlHeight}" />
    <Setter Property="Padding" Value="10,0,0,0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="FontSize" Value="{DynamicResource LuxFontSize}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Panel>
        <Border Name="PART_Row" Background="{TemplateBinding Background}" CornerRadius="0">
          <Grid ColumnDefinitions="Auto,*" Margin="{TemplateBinding BorderThickness}">
            <Border Name="PART_Box" Width="16" Height="16" CornerRadius="2" BorderThickness="1.5"
                    BorderBrush="{TemplateBinding BorderBrush}" Background="Transparent"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
              <Panel>
                <Path Name="PART_Check" Data="M 3,8 L 6.5,11.5 L 13,4.5" Stroke="{DynamicResource LuxOnAccent}"
                      StrokeThickness="2" IsVisible="False" Margin="-1.5" />
                <Rectangle Name="PART_Indeterminate" Width="8" Height="2" Fill="{DynamicResource LuxOnAccent}" IsVisible="False" />
              </Panel>
            </Border>
            <ContentPresenter Name="PART_ContentPresenter" Grid.Column="1"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Padding="{TemplateBinding Padding}"
                              Foreground="{TemplateBinding Foreground}"
                              RecognizesAccessKey="True"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </Grid>
        </Border>
        <Border Name="PART_Focus" BorderBrush="{DynamicResource LuxAccent}" BorderThickness="2" CornerRadius="2" IsVisible="False" IsHitTestVisible="False" />
        </Panel>
      </ControlTemplate>
    </Setter>
    <Style Selector="^:pointerover /template/ Border#PART_Box">
      <Setter Property="BorderBrush" Value="{DynamicResource LuxText}" />
    </Style>
    <Style Selector="^:checked /template/ Border#PART_Box">
      <Setter Property="Background" Value="{DynamicResource LuxAccent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LuxAccent}" />
    </Style>
    <Style Selector="^:checked /template/ Path#PART_Check">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:indeterminate /template/ Border#PART_Box">
      <Setter Property="Background" Value="{DynamicResource LuxAccent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LuxAccent}" />
    </Style>
    <Style Selector="^:indeterminate /template/ Rectangle#PART_Indeterminate">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:disabled">
      <Setter Property="Foreground" Value="{DynamicResource LuxTextDisabled}" />
    </Style>
    <Style Selector="^:disabled /template/ Border#PART_Box">
      <Setter Property="BorderBrush" Value="{DynamicResource LuxLineLight}" />
    </Style>
    <Style Selector="^:disabled:checked /template/ Border#PART_Box">
      <Setter Property="Background" Value="{DynamicResource LuxLineLight}" />
    </Style>
    <!-- a format / option row: whole row is the hit target, filled when ticked -->
    <Style Selector="^.optionrow">
      <Setter Property="Padding" Value="8,0" />
      <Setter Property="BorderThickness" Value="8,0" />
    </Style>
    <Style Selector="^.optionrow:checked">
      <Setter Property="Background" Value="{DynamicResource LuxBar}" />
    </Style>
    <Style Selector="^.optionrow:pointerover">
      <Setter Property="Background" Value="{DynamicResource LuxHover}" />
    </Style>
  </ControlTheme>

  <ControlTheme x:Key="{x:Type ProgressBar}" TargetType="ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource LuxAccent}" />
    <Setter Property="Background" Value="{DynamicResource LuxLineMid}" />
    <Setter Property="Height" Value="4" />
    <Setter Property="MinHeight" Value="4" />
    <Setter Property="Minimum" Value="0" />
    <Setter Property="Maximum" Value="1" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="PART_Track" Background="{TemplateBinding Background}" ClipToBounds="True">
          <Panel>
            <Border Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" />
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>
    <Style Selector="^.done">
      <Setter Property="Foreground" Value="{DynamicResource LuxSuccess}" />
    </Style>
    <Style Selector="^.failed">
      <Setter Property="Foreground" Value="{DynamicResource LuxWarning}" />
    </Style>
    <Style Selector="^:indeterminate /template/ Border#PART_Indicator">
      <Setter Property="Width" Value="60" />
      <Setter Property="Opacity" Value="0.7" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
