<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Test build (-p:LuxSimdPortable=true): the vector operations of Imaging/Simd.cs use their portable code on every processor. -->
  <PropertyGroup Condition="'$(LuxSimdPortable)' == 'true'">
    <DefineConstants>$(DefineConstants);LUX_SIMD_PORTABLE</DefineConstants>
  </PropertyGroup>

  <!-- Build-time C# generation from the 36 reconstructed ltpb .proto files (messages only) -->
  <ItemGroup>
    <Protobuf Include="Protos\**\*.proto" GrpcServices="None" ProtoRoot="Protos" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.36.2" />
    <PackageReference Include="Grpc.Tools" Version="2.85.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Pipeline\Isp\Data\IrCorrectionTables.bin" LogicalName="IrCorrectionTables.bin" />
    <EmbeddedResource Include="Pipeline\Fusion\BayerWaveletNoiseGain.bin" LogicalName="BayerWaveletNoiseGain.bin" />
    <EmbeddedResource Include="Pipeline\Export\Data\ToneCurves.bin" LogicalName="ToneCurves.bin" />
  </ItemGroup>

</Project>
