<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>lux-light</AssemblyName>
    <!-- The build's version: `lux-light version` compares it with the latest GitHub release tag (v<Version>). Bump it with each release. -->
    <Version>1.2.0</Version>
    <RootNamespace>Lux.Cli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The tile render allocates its scratch per tile on many threads; the workstation collector let ~20 GB of dead
         scratch accumulate before collecting (22 GB peak RSS at 24 threads), the server collector keeps it near the
         sequential footprint (8 GB) at the same speed. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lux.Engine\Lux.Engine.csproj" />
  </ItemGroup>

</Project>
